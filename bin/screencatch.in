#!@PYTHON@
"""Launcher for ScreenCatch."""

import os
import signal
import sys

PKGDATADIR = "@PKGDATADIR@"
DATADIR = "@DATADIR@"


def _use_private_prefix():
    """Make a non-system install (e.g. ./run-dev.sh) find its schema and icons."""
    if DATADIR in ("/usr/share", "/usr/local/share"):
        return
    schemas = os.path.join(DATADIR, "glib-2.0", "schemas")
    if os.path.isfile(os.path.join(schemas, "gschemas.compiled")):
        current = os.environ.get("GSETTINGS_SCHEMA_DIR")
        os.environ["GSETTINGS_SCHEMA_DIR"] = schemas + (os.pathsep + current if current else "")
    data_dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    if DATADIR not in data_dirs.split(os.pathsep):
        os.environ["XDG_DATA_DIRS"] = DATADIR + os.pathsep + data_dirs


if __name__ == "__main__":
    _use_private_prefix()
    sys.path.insert(1, PKGDATADIR)
    signal.signal(signal.SIGINT, signal.SIG_DFL)

    from screencatch import main

    sys.exit(main.run(PKGDATADIR))
