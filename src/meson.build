moduledir = pkgdatadir / 'screencatch'

install_data(
  'screencatch/__init__.py',
  'screencatch/capture.py',
  'screencatch/export.py',
  'screencatch/gtkutil.py',
  'screencatch/main.py',
  'screencatch/overlay.py',
  'screencatch/preferences.py',
  'screencatch/shortcut.py',
  'screencatch/window.py',
  install_dir: moduledir,
)

install_data(
  'screencatch/editor/__init__.py',
  'screencatch/editor/canvas.py',
  'screencatch/editor/document.py',
  'screencatch/editor/history.py',
  'screencatch/editor/shapes.py',
  'screencatch/editor/window.py',
  install_dir: moduledir / 'editor',
)
