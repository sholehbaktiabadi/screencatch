<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="screencatch">
  <schema id="io.github.sholehbaktiabadi.ScreenCatch" path="/io/github/sholehbaktiabadi/ScreenCatch/">
    <key name="save-directory" type="s">
      <default>''</default>
      <summary>Save folder</summary>
      <description>Folder for saved screenshots. Empty means the Screenshots folder inside the user's Pictures folder.</description>
    </key>
    <key name="filename-template" type="s">
      <default>'Screenshot_%Y-%m-%d_%H-%M-%S'</default>
      <summary>File name template</summary>
      <description>strftime-style template for new file names. ".png" is appended automatically.</description>
    </key>
    <key name="enter-action" type="s">
      <choices>
        <choice value="edit"/>
        <choice value="copy"/>
        <choice value="save"/>
      </choices>
      <default>'edit'</default>
      <summary>Quick action in the selection overlay</summary>
      <description>What Enter and double-click do after selecting a region.</description>
    </key>
    <key name="done-copy" type="b">
      <default>true</default>
      <summary>Copy on Done</summary>
    </key>
    <key name="done-save" type="b">
      <default>true</default>
      <summary>Save on Done</summary>
    </key>
    <key name="close-after-done" type="b">
      <default>true</default>
      <summary>Close the editor on Done</summary>
    </key>
    <key name="tool" type="s">
      <default>'arrow'</default>
      <summary>Last used editor tool</summary>
    </key>
    <key name="color" type="s">
      <default>'#e01b24'</default>
      <summary>Last used annotation color</summary>
    </key>
    <key name="stroke-width" type="i">
      <range min="1" max="32"/>
      <default>4</default>
      <summary>Last used annotation size</summary>
    </key>
    <key name="delay" type="i">
      <range min="0" max="30"/>
      <default>0</default>
      <summary>Capture delay used by the main window, in seconds</summary>
    </key>
    <key name="hotkey" type="s">
      <default>'&lt;Control&gt;&lt;Shift&gt;Print'</default>
      <summary>Global capture shortcut</summary>
    </key>
    <key name="hotkey-enabled" type="b">
      <default>true</default>
      <summary>Whether the global shortcut is registered</summary>
    </key>
    <key name="hotkey-initialized" type="b">
      <default>false</default>
      <summary>Whether first-run shortcut setup already happened</summary>
    </key>
  </schema>
</schemalist>
